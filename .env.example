# --- API keys ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
FRED_API_KEY=your_fred_api_key

# --- Database ---
# Three possible targets. Pick one and fill in the matching values below.
#
#   1. Docker Compose (local dev) -> DB_HOST=db
#   2. Postgres on this machine   -> DB_HOST=localhost
#   3. Supabase (production)      -> DB_HOST=aws-0-<region>.pooler.supabase.com
#
# For Supabase, copy the Session pooler connection parameters from the
# dashboard (Connect -> Session pooler). Do not use the direct connection:
# it resolves over IPv6 only and GitHub Actions runners cannot reach it.

DB_HOST=db
DB_PORT=5432

# 'economic_pipeline' for local Postgres, 'postgres' for Supabase.
DB_NAME=economic_pipeline

# 'postgres' for local Postgres. The Supabase pooler user carries the
# project ref: postgres.<project_ref>
DB_USER=postgres

DB_PASSWORD=your_db_password

# 'disable' for local Postgres, which serves plain connections.
# 'require' for Supabase, which rejects unencrypted ones.
DB_SSLMODE=disable
